{
  "manifest_version": 3,
  "name": "API Tester",
  "short_name": "API Tester",
  "version": "1.0.0",
  "description": "Send HTTP requests, inspect responses, and keep a searchable history — right from your browser.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open API Tester",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/index.html?context=sidepanel"
  },
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "options_page": "src/index.html",
  "minimum_chrome_version": "114"
}
